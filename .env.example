# Supabase — AXIOM data layer
# Project: gyxhnfjmkomvmoxutias  (https://gyxhnfjmkomvmoxutias.supabase.co)
#
# Client-safe (exposed to the browser by design). Prefer the modern
# publishable key (sb_publishable_...) over the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt

# SERVER ONLY. Never prefix with NEXT_PUBLIC. This key BYPASSES Row Level
# Security — use it only in server code for admin/curator/service operations.
SUPABASE_SERVICE_ROLE_KEY=
